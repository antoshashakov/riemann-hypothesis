namespace Formalism.ZF

lemma landauLocal_logDeriv_prod (Z : Finset ℂ) (m : ℂ → ℕ) (z : ℂ)
    (hz : ∀ ρ ∈ Z, z - ρ ≠ 0) :
    logDeriv (fun w => ∏ ρ ∈ Z, (w - ρ) ^ m ρ) z = ∑ ρ ∈ Z, (m ρ : ℂ) / (z - ρ) :=
  LocalZeroFactorizationBounds.logDeriv_product Z m z hz

theorem localZeroExpansionOfFactorization : LandauLocalOf := by
  unfold LandauLocalOf LandauLocal
  intro hfac hlog f z₀ r M hr hM hf hf0 hbound
  have hr3 : 0 < r / 3 := by positivity
  obtain ⟨Z, m, h, hZ, hm, hh, hh0, hfeq⟩ := hfac f z₀ r (r / 3) hr3 (by linarith) hf hf0
  obtain ⟨hcount, hrem⟩ := LocalZeroFactorizationBounds.bounds_of_factorization hlog hr hM Z m
    (fun ρ hρ => (hZ ρ).mp hρ) hh hh0 hfeq hbound
  exact ⟨Z, m, hZ, hm, hcount, hrem⟩

end Formalism.ZF
